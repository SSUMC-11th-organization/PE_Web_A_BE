{
  "info": {
    "name": "6주차 영화 평점 저장 API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "email", "value": "" },
    { "key": "nickname", "value": "" },
    { "key": "memberId", "value": "" },
    { "key": "ratingId", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "if (!pm.collectionVariables.get('email')) {",
          "  const suffix = Date.now().toString().slice(-6);",
          "  pm.collectionVariables.set('email', `week6-${suffix}@umc.com`);",
          "  pm.collectionVariables.set('nickname', `테스트${suffix}`);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "회원가입 성공",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"Umc!1234\",\n  \"nickname\": \"{{nickname}}\"\n}" },
        "url": "{{baseUrl}}/members"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('201 Created', () => pm.response.to.have.status(201));",
        "const body = pm.response.json();",
        "pm.collectionVariables.set('memberId', body.result.memberId);",
        "pm.test('비밀번호 응답 제외', () => pm.expect(body.result).not.to.have.property('password'));"
      ] } }]
    },
    {
      "name": "잘못된 이메일 400",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"wrong-email\",\n  \"password\": \"Umc!1234\",\n  \"nickname\": \"오류테스트\"\n}" },
        "url": "{{baseUrl}}/members"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"] } }]
    },
    {
      "name": "중복 이메일 409",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"Umc!1234\",\n  \"nickname\": \"다른닉네임\"\n}" },
        "url": "{{baseUrl}}/members"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"] } }]
    },
    {
      "name": "평점 등록 성공",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"movieId\": 680,\n  \"score\": 5,\n  \"comment\": \"재밌었음\"\n}" },
        "url": "{{baseUrl}}/members/{{memberId}}/ratings"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('201 Created', () => pm.response.to.have.status(201));",
        "pm.collectionVariables.set('ratingId', pm.response.json().result);"
      ] } }]
    },
    {
      "name": "중복 평점 409",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"movieId\": 680,\n  \"score\": 4,\n  \"comment\": \"중복\"\n}" },
        "url": "{{baseUrl}}/members/{{memberId}}/ratings"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"] } }]
    },
    {
      "name": "잘못된 별점 400",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"movieId\": 681,\n  \"score\": 6,\n  \"comment\": \"범위 오류\"\n}" },
        "url": "{{baseUrl}}/members/{{memberId}}/ratings"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"] } }]
    },
    {
      "name": "평점 수정 성공",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"score\": 4,\n  \"comment\": \"다시 보니 괜찮았음\"\n}" },
        "url": "{{baseUrl}}/members/{{memberId}}/ratings/{{ratingId}}"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }]
    },
    {
      "name": "다른 회원 수정 403",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"score\": 3,\n  \"comment\": \"남의 평점\"\n}" },
        "url": "{{baseUrl}}/members/1/ratings/{{ratingId}}"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('403 Forbidden', () => pm.response.to.have.status(403));"] } }]
    },
    {
      "name": "없는 평점 404",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"score\": 3,\n  \"comment\": \"없는 평점\"\n}" },
        "url": "{{baseUrl}}/members/{{memberId}}/ratings/999999"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"] } }]
    },
    {
      "name": "평점 삭제 204",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/members/{{memberId}}/ratings/{{ratingId}}"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"] } }]
    }
  ]
}
