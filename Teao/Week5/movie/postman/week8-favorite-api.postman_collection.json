{
  "info": {
    "name": "8주차 즐겨찾기와 영화 기록 API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "email", "value": "" },
    { "key": "nickname", "value": "" },
    { "key": "token", "value": "" },
    { "key": "movieId", "value": "" },
    { "key": "recordMovieId", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "if (!pm.collectionVariables.get('email')) {",
          "  const suffix = Date.now().toString().slice(-7);",
          "  pm.collectionVariables.set('email', `week8-${suffix}@umc.com`);",
          "  pm.collectionVariables.set('nickname', `즐겨찾기${suffix.slice(-4)}`);",
          "  pm.collectionVariables.set('movieId', suffix);",
          "  pm.collectionVariables.set('recordMovieId', String(Number(suffix) + 1));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "회원가입",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"Umc!1234\",\n  \"nickname\": \"{{nickname}}\"\n}" },
        "url": "{{baseUrl}}/members"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('회원가입 201', () => pm.response.to.have.status(201));"] } }]
    },
    {
      "name": "로그인",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"Umc!1234\"\n}" },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('로그인 200', () => pm.response.to.have.status(200));",
        "pm.collectionVariables.set('token', pm.response.json().result.accessToken);"
      ] } }]
    },
    {
      "name": "등록 전 즐겨찾기 여부 false",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/favorites/{{movieId}}"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('여부 조회 200', () => pm.response.to.have.status(200));",
        "pm.test('등록 전 false', () => pm.expect(pm.response.json().result.isFavorite).to.eql(false));"
      ] } }]
    },
    {
      "name": "즐겨찾기 등록",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"movieId\": {{movieId}}\n}" },
        "url": "{{baseUrl}}/favorites"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('즐겨찾기 201', () => pm.response.to.have.status(201));",
        "pm.test('COMMON201', () => pm.expect(pm.response.json().code).to.eql('COMMON201'));"
      ] } }]
    },
    {
      "name": "즐겨찾기 중복 409",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"movieId\": {{movieId}}\n}" },
        "url": "{{baseUrl}}/favorites"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('중복 409', () => pm.response.to.have.status(409));",
        "pm.test('FAVORITE409_1', () => pm.expect(pm.response.json().code).to.eql('FAVORITE409_1'));"
      ] } }]
    },
    {
      "name": "내 즐겨찾기 목록",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/favorites"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('목록 200', () => pm.response.to.have.status(200));",
        "pm.test('목록 1건 이상', () => pm.expect(pm.response.json().result.length).to.be.above(0));"
      ] } }]
    },
    {
      "name": "등록 후 즐겨찾기 여부 true",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/favorites/{{movieId}}"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('여부 조회 200', () => pm.response.to.have.status(200));",
        "pm.test('등록 후 true', () => pm.expect(pm.response.json().result.isFavorite).to.eql(true));"
      ] } }]
    },
    {
      "name": "즐겨찾기 해제",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/favorites/{{movieId}}"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('해제 200', () => pm.response.to.have.status(200));",
        "pm.test('COMMON200', () => pm.expect(pm.response.json().code).to.eql('COMMON200'));"
      ] } }]
    },
    {
      "name": "없는 즐겨찾기 해제 404",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/favorites/{{movieId}}"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('없는 즐겨찾기 404', () => pm.response.to.have.status(404));",
        "pm.test('FAVORITE404_1', () => pm.expect(pm.response.json().code).to.eql('FAVORITE404_1'));"
      ] } }]
    },
    {
      "name": "영화 기록 저장",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"movieId\": {{recordMovieId}},\n  \"score\": 5,\n  \"comment\": \"다시 보고 싶은 영화\",\n  \"addToFavorites\": true\n}" },
        "url": "{{baseUrl}}/movie-records"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('영화 기록 201', () => pm.response.to.have.status(201));",
        "const result = pm.response.json().result;",
        "pm.test('평점과 즐겨찾기 동시 반환', () => { pm.expect(result.rating).to.be.an('object'); pm.expect(result.favorite).to.be.an('object'); });"
      ] } }]
    },
    {
      "name": "영화 기록 중복 409",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"movieId\": {{recordMovieId}},\n  \"score\": 5,\n  \"comment\": \"중복 기록\",\n  \"addToFavorites\": true\n}" },
        "url": "{{baseUrl}}/movie-records"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('중복 기록 409', () => pm.response.to.have.status(409));",
        "pm.test('RATING409_1', () => pm.expect(pm.response.json().code).to.eql('RATING409_1'));"
      ] } }]
    },
    {
      "name": "토큰 없이 즐겨찾기 401",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"movieId\": 1\n}" },
        "url": "{{baseUrl}}/favorites"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('토큰 없음 401', () => pm.response.to.have.status(401));",
        "pm.test('AUTH401_2', () => pm.expect(pm.response.json().code).to.eql('AUTH401_2'));"
      ] } }]
    }
  ]
}
